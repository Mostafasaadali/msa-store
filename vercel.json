{
  "cleanUrls": true,
  "routes": [
    { "handle": "filesystem" },
    { 
      "src": "/__/auth/(.*)", 
      "dest": "https://msa-store-b125f.firebaseapp.com/__/auth/$1" 
    },
    { "src": "/(.*)", "dest": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*\\.html)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ]
}
